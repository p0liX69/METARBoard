[Unit]
Description=METARBoard aviation weather/chart display server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=metarboard
Group=metarboard
WorkingDirectory=/opt/metarboard
ExecStart=/usr/bin/node /opt/metarboard/server.js
EnvironmentFile=-/opt/metarboard/.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
