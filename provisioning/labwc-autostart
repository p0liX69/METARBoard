#!/bin/sh
# labwc autostart for the METARBoard kiosk appliance. Installed by
# setup-pi.sh to ~/.config/labwc/autostart for the desktop-login user.
# Deliberately omits the default wf-panel-pi taskbar and pcmanfm-pi
# desktop/wallpaper manager - this is a dedicated-purpose display, not a
# general desktop. kanshi is kept so display/output configuration still
# works. lwrespawn auto-restarts chromium if it ever crashes.
#
# --password-store=basic: without this, Chromium's first attempt to touch
# its password manager talks to the OS keyring (libsecret/gnome-keyring),
# which was never unlocked because autologin skips the normal PAM flow that
# would unlock it - the result is a "enter password to unlock your login
# keyring" dialog sitting on top of the kiosk with no keyboard to answer it.
# This flag tells Chromium to use its own internal store instead, so it
# never talks to the keyring at all.
#
# --incognito: after a crash/kill, Chromium can silently restore the
# previous tab's rendered state instead of doing a real navigation, which
# makes a freshly-deployed index.html/JS look like it never took effect.
# Incognito mode has no persistent profile to restore from, so every launch
# is a genuine fresh load. localStorage still works normally for the
# lifetime of a single running browser process (page reloads keep it) - it
# only resets on the next full relaunch, which is the behavior we want for
# an appliance that should reflect current server settings, not months-old
# cached state.
#
/usr/bin/kanshi &

# Shows the METARBoard mark on the same navy background as the boot splash
# (provisioning/plymouth/) while Chromium is still starting - without
# this there's a plain black screen for several seconds between Plymouth
# handing off and Chromium's first paint (plus however long the
# backend-wait loop below takes), which looks identical to the display
# being broken on an appliance with no other status indicator. Chromium
# launches --start-fullscreen and covers this entirely once it paints, so
# there's no need to kill swaybg afterward - it's just never visible again
# unless something clears the screen in front of it.
/usr/bin/swaybg -i "${HOME}/.config/labwc/kiosk-loading-bg.png" -m fill &

# metarboard.service starts on its own systemd track with no ordering
# guarantee relative to the desktop session/autologin reaching this
# script - confirmed live that Chromium routinely wins the race and
# navigates to http://localhost:8500 before the backend is listening,
# landing on Chromium's own "ERR_CONNECTION_REFUSED" interstitial. That
# page has no visible loading indicator, and Chromium's built-in
# retry/backoff for it takes on the order of 15-20s to recover on its
# own - confusing on an appliance with no keyboard/mouse to tell someone
# it's not actually broken. Waiting here for a real 200 before ever
# launching Chromium means the very first navigation just succeeds.
# The loop breaks the instant /health returns 200, so a healthy backend
# never adds delay here regardless of the cap - the cap only bounds how
# long we wait on a backend that's slow or broken. 10 attempts (~13s) was
# confirmed live to be too short on this CM5: the node process wasn't
# serving /health until ~20s into boot (systemd "Started" plus chart/db
# load), so Chromium launched into ERR_CONNECTION_REFUSED anyway. Raised
# to 60 (~60s typical, more if a hung backend keeps hitting the 2s curl
# timeout) - the loading background stays on screen the whole time, which
# is the intended "still starting" indication, so a longer wait here just
# means a nicer screen for longer, never an error. A genuinely broken
# backend is still ultimately covered by lwrespawn/the watchdog after the
# cap. --max-time on curl is not optional - confirmed live that a single
# hung attempt with no timeout can stall this loop forever.
for i in $(seq 1 60); do
    curl -s -o /dev/null --max-time 2 http://localhost:8500/health && break
    sleep 1
done

# Launch Chromium under lwrespawn via a dedicated launcher script
# (kiosk-chromium-launch.sh) that clears Chromium's stale SingletonLock
# before EVERY (re)launch - the setup wizard's "Name This Display" rename
# changes the hostname at runtime, and Chromium refuses a lock created
# under a different hostname, crash-looping invisibly otherwise. Clearing
# once at session start isn't enough because lwrespawn relaunches by
# re-running only its command, not this whole script - see that script's
# header for the full rationale (and the Wayland/incognito/etc. flags).
#
# Invoked as `/bin/sh <path>`, not the script directly, for three reasons:
# lwrespawn does `pgrep $1` and bails if it matches (a bare `sh` would
# match every shell; the literal `/bin/sh` string matches no process
# name), it re-runs its args with an UNQUOTED `$@` (so an inline `sh -c`
# quoted command gets word-split and shattered - a plain path can't), and
# `/bin/sh <path>` doesn't depend on the script's exec bit surviving a
# release tarball's extraction. Referenced via the /opt/metarboard symlink
# (like chromium-watchdog.sh) so OTA updates carry launcher/flag changes.
/usr/bin/lwrespawn /bin/sh /opt/metarboard/provisioning/kiosk-chromium-launch.sh &

# --remote-debugging-port above is loopback-only (127.0.0.1, never exposed
# on the network) and exists solely so chromium-watchdog.sh can tell a live
# app tab apart from a crashed one - see that script for why lwrespawn alone
# isn't enough. Referenced via the /opt/metarboard symlink (not a copied
# path like this autostart file) so OTA updates carry watchdog fixes
# automatically. Run via `sh` rather than direct exec so this doesn't
# depend on the executable bit surviving a release tarball's extraction.
sh /opt/metarboard/provisioning/chromium-watchdog.sh &
